    },
    "Stopped: the Mac is too hot": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêté : le Mac est trop chaud"
          }
        }
      }
    },
    "Stopped: time is up": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêté : temps écoulé"
          }
        }
      }
    },
    "The Mac stays awake with its lid closed, without an external display: on power only, for %d hours at most, never when it is hot. A closed Mac cools less well: never put it in a bag while Awake is on.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Mac reste éveillé capot fermé, sans écran externe : sur secteur seulement, %d heures au plus, jamais quand il chauffe. Un Mac fermé refroidit moins bien : ne le mettez jamais dans un sac pendant qu’Awake est activé."
          }
        }
      }
    },
    "The lid can stay closed": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le capot peut rester fermé"
          }
        }
      }
    },
    "Until": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jusqu’à"
          }
        }
      }
    },
    "Until %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
