            "value": "Jusqu’à %@"
          }
        }
      }
    },
    "Until Stopped": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jusqu’à l’arrêt"
          }
        }
      }
    },
    "While Awake is on, the screen goes off after this long without use; the Mac stays awake.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendant qu’Awake est activé, l’écran s’éteint après ce délai sans utilisation ; le Mac reste éveillé."
          }
        }
      }
    }
  },
  "version": "1.0"
}
